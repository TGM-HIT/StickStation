<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="StickStation.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:StickStation.Core"
    xmlns:vm="using:StickStation.Core.ViewModels"
    xmlns:svc="using:StickStation.Services"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <Page.Resources>
        <Style x:Key="TileStyle" TargetType="Border">
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <ScrollViewer Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <StackPanel Padding="24,8,24,24" Spacing="16">
                <StackPanel Spacing="4">
                    <TextBlock x:Uid="Tagline" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Uid="TaglineDetail" Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock x:Uid="BatchSetup" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <StackPanel Spacing="4">
                    <TextBlock x:Uid="BackupDirectory" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Uid="BackupDirectoryHint" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Command="{x:Bind ViewModel.ChooseBackupFolderCommand}"
                            IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.BackupRoot, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8B7;" FontSize="16" />
                            <TextBlock Text="{x:Bind ViewModel.BackupFolderName, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.CanEditAssignment, Mode=OneWay}">
                    <TextBlock x:Uid="AssignmentSource" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Uid="AssignmentSourceHint" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Command="{x:Bind ViewModel.ChooseAssignmentFolderCommand}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.SourceRoot, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8B7;" FontSize="16" />
                                <TextBlock Text="{x:Bind ViewModel.SourceFolderName, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>
                        <Button x:Uid="ClearAssignment" Grid.Column="1" Command="{x:Bind ViewModel.ClearAssignmentCommand}"
                                Visibility="{x:Bind ViewModel.HasSource, Mode=OneWay}">
                            <FontIcon Glyph="&#xE711;" FontSize="14" />
                        </Button>
                    </Grid>
                </StackPanel>

                <ToggleSwitch x:Uid="BackUpOnly" IsOn="{x:Bind ViewModel.BackupOnly, Mode=TwoWay}"
                              IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />

                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.CanEditFormat, Mode=OneWay}">
                    <ToggleSwitch x:Uid="FormatFat32" IsOn="{x:Bind ViewModel.Format, Mode=TwoWay}" />
                    <TextBlock x:Uid="FormatFat32Hint" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                         x:Uid="VerifiedInfo" />
            </StackPanel>
        </ScrollViewer>

        <!-- Dashboard -->
        <Grid Grid.Column="1" Padding="24,8,24,16" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Uid="Workspace" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.HeaderStatusText, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.LimitText, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <ProgressRing Grid.Column="1" Width="28" Height="28" IsActive="{x:Bind ViewModel.Running, Mode=OneWay}" />
            </Grid>

            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource TileStyle}">
                    <StackPanel>
                        <TextBlock x:Uid="Phase_Todo_Tile" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.TodoCount, Mode=OneWay}" Style="{StaticResource TitleLargeTextBlockStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource TileStyle}">
                    <StackPanel>
                        <TextBlock x:Uid="Tile_InProcess" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.InProcessCount, Mode=OneWay}" Style="{StaticResource TitleLargeTextBlockStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource TileStyle}">
                    <StackPanel>
                        <TextBlock x:Uid="Tile_Completed" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.CompletedCount, Mode=OneWay}" Style="{StaticResource TitleLargeTextBlockStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="ConnectedSticks" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button x:Uid="SelectAll" Command="{x:Bind ViewModel.SelectAllCommand}" />
                        <Button x:Uid="Refresh" Command="{x:Bind ViewModel.RefreshCommand}">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>

                <GridView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Sticks, Mode=OneTime}" SelectionMode="None"
                          Visibility="{x:Bind ViewModel.HasSticks, Mode=OneWay}"
                          IsItemClickEnabled="False">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="vm:StickRowViewModel">
                            <Border Width="270" Padding="14" CornerRadius="8" BorderThickness="1"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <Grid RowSpacing="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Row="0" Grid.Column="0" MinWidth="0"
                                              IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                              IsEnabled="{x:Bind CanSelect, Mode=OneWay}"
                                              AutomationProperties.Name="{x:Bind Name, Mode=OneTime}">
                                        <TextBlock Text="{x:Bind Name, Mode=OneTime}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    </CheckBox>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                VerticalAlignment="Center">
                                        <FontIcon Glyph="{x:Bind svc:PhaseStyle.Glyph(Phase), Mode=OneWay}" FontSize="14"
                                                  Foreground="{x:Bind svc:PhaseStyle.Brush(Phase), Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind PhaseTitle, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{x:Bind svc:PhaseStyle.Brush(Phase), Mode=OneWay}" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{x:Bind CapacityText, Mode=OneTime}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{x:Bind StatusText, Mode=OneWay}"
                                               TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}" />
                                    <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                                        <Button x:Uid="ShowBackup" Tag="{x:Bind Mode=OneTime}" Click="ShowBackup_Click"
                                                Visibility="{x:Bind HasBackup, Mode=OneWay}" />
                                        <TextBlock x:Uid="Disconnected" VerticalAlignment="Center"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                   Visibility="{x:Bind ShowDisconnected, Mode=OneWay}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                    <FontIcon Glyph="&#xE88E;" FontSize="48" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Uid="EmptyTitle" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                    <TextBlock x:Uid="EmptyDetail" MaxWidth="420" TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="3" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.SelectedText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.FooterHint, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.FinishedText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="{x:Bind ViewModel.Running, Mode=OneWay}" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" MinWidth="200" Padding="16,10"
                        Command="{x:Bind ViewModel.StartCommand}">
                    <TextBlock Text="{x:Bind ViewModel.ActionText, Mode=OneWay}" />
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Page>
